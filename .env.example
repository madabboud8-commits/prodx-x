# X: settings file
# ===================================================================
# Copy this file to `.env` (same folder) and fill in what you need.
# `.env` is ignored by git: your keys never go to GitHub.
# Never paste a key in a chat.

# ---- Voice (ElevenLabs) -------------------------------------------
# Your ElevenLabs API key (elevenlabs.io > Profile > API keys).
# With it X speaks in your voice and understands Lebanese + English.
# Without it X falls back to the browser's voice.
ELEVENLABS_API_KEY=

# X's voice. Default is the PRODX voice already chosen.
X_VOICE_ID=oJQlz7pz2yWd7MRmDUXm

# Voice model. Flash is the fastest. If the Arabic sounds off, try
# eleven_multilingual_v2 (better quality, slower).
X_TTS_MODEL=eleven_flash_v2_5

# ---- Listening ----------------------------------------------------
# How long you must pause before X answers (milliseconds). 5000 = 5 s.
# Saying "done" or "خلص" at the end makes X answer right away.
VITE_END_PAUSE_MS=5000

# After X answers, how long it keeps listening without "Hey X" (ms).
VITE_FOLLOW_UP_MS=120000

# Browser fallback recognition language (only used with no ElevenLabs key).
VITE_SPEECH_LANG=ar-LB

# ---- Brain ----------------------------------------------------------
# Runs on your Claude Code login. No Anthropic API key needed.
# X_MODEL=claude-opus-5
# Lower effort answers faster on camera: low | medium | high
# X_EFFORT=medium

# ---- Lab folder -----------------------------------------------------
# Where X keeps test files, results and the photo inbox.
# Default: the `lab` folder inside this project.
# X_LAB_DIR=

# ---- Advanced -------------------------------------------------------
# X_BRIDGE_PORT=8787
# VITE_BRIDGE_URL=ws://localhost:8787
